{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "① 构建 FORCE 数据集",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/build_dataset.py",
      "args": ["--dataset", "force2020"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "② FORCE 岩性分类基线",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/baseline_rf.py",
      "args": ["--dataset", "force2020", "--folds", "5"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "③ 环境自检（GPU）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/demo_torch.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "④ 当前文件（带断点调试）",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
